# Entornos virtuales de Python
.venv/
venv/
env/
ENV/

# Bytecode de Python
__pycache__/
*.py[cod]
*$py.class   
# Pytest
.pytest_cache/

# Resultados de escaneo / capturas (pueden contener datos de la red)
*.pcap
*.pcapng
informe*.json
informe*.csv

# Excepción: la captura sintética de ejemplo sí se sube
!ejemplos/*.pcap

# Cobertura de tests
.coverage
htmlcov/

# Registros de --log (llevan MAC, IP y hostnames reales)
*.log

# Clave de la API de NVD (--cve): es personal, no se sube
nvd_api_key.txt
